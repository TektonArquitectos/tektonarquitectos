# ── Google Analytics 4 ──────────────────────────────────────────
# 1. Crea una propiedad GA4 en https://analytics.google.com
# 2. Copia el "ID de medición" (formato G-XXXXXXXXXX)
# 3. Pégalo aquí abajo y renombra este archivo a .env.local
# 4. En producción (Vercel, etc.) agrega esta misma variable en
#    la configuración de variables de entorno del proyecto.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Panel de Administrador ──────────────────────────────────────
# Cadena aleatoria larga usada para firmar la sesión del admin.
# Genera una con: openssl rand -base64 32
ADMIN_JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# ── Base de datos (Vercel Postgres / Neon) ──────────────────────
# Se configura automáticamente al conectar un almacén Postgres
# desde el panel de Vercel (Storage → Create Database → Postgres/Neon).
# No la definas manualmente en producción.
# POSTGRES_URL=postgres://...

# ── Almacenamiento de imágenes (Vercel Blob) ────────────────────
# Se configura automáticamente al conectar un Blob Store desde
# el panel de Vercel (Storage → Create Database → Blob).
# No la definas manualmente en producción.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
